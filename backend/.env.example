# ─── Engine Selection ────────────────────────────────────────────────
# "pandas"  — lightweight, fast startup, ideal for MVP and small files
# "spark"   — PySpark engine for larger datasets and production workloads
ENGINE_MODE=pandas

# ─── File Storage ────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ─── API ─────────────────────────────────────────────────────────────
DEBUG=false

# ─── LLM (Stage 5) ───────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
